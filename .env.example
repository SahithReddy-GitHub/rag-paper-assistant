# Copy this file to ".env" and fill in your key. Never commit .env to GitHub.

# --- Option A: Groq (free tier, fast) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-20b

# --- Option B: Ollama (runs locally, no key needed) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2

# --- Option C: Google Gemini (free tier) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your_gemini_key_here
# LLM_MODEL=gemini-2.5-flash
